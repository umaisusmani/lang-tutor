# Groq — LLM for the conversation, corrections and word glosses (free tier: console.groq.com)
GROQ_API_KEY=

# Supabase — database + auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to write token-usage logs and the daily message counters,
# which no user session may touch. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Hard cap on messages the whole app serves per UTC day (budget backstop).
# Per-user caps are in lib/services/session.service.ts. Defaults to 300.
# GLOBAL_DAILY_MESSAGE_CAP=300

# Google Gemini — embeddings for the grammar-rule RAG corpus (planned, not used yet)
# GOOGLE_GENERATIVE_AI_API_KEY=
